# Скопируйте в .env и поменяйте значения. Файл .env не коммитится.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://nextgenhub.kg

# Максимальный размер загружаемого видео, МБ
MAX_VIDEO_UPLOAD_MB=500

# База данных: sqlite (по умолчанию) или postgres
DB_ENGINE=sqlite
# DB_NAME=nextgenhub
# DB_USER=nextgenhub
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Контакты на сайте
SITE_PHONE=+996 555 123 456
SITE_EMAIL=hello@nextgenhub.kg
# SITE_ADDRESS=Ош, ул. Гапара Айтиева, 14а   (если пусто — переводится автоматически)
# SITE_HOURS=Пн–Сб, 9:00–20:00
SITE_INSTAGRAM=https://instagram.com/nextgenhub.kg
SITE_TELEGRAM=https://t.me/nextgenhub_kg
SITE_WHATSAPP=https://wa.me/996555123456
SITE_MAP_URL=https://go.2gis.com/fdRkC
SITE_MAP_LAT=40.524921
SITE_MAP_LON=72.772097
